# 이 파일을 .env.properties로 복사한 뒤 실제 로컬 값을 입력하세요.
# .env.properties는 Git에 포함되지 않습니다.
DB_URL=jdbc:mysql://127.0.0.1:3306/moviesite?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
# JWT 키를 교체할 때만 이전 키를 잠시 설정합니다. 기존 토큰 만료 후 비워도 됩니다.
JWT_PREVIOUS_SECRET=
JWT_EXPIRATION_SECONDS=3600
ADMIN_REGISTRATION_CODE=
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_PASSWORD=
